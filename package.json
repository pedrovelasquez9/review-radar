{
  "name": "opencode-review-radar",
  "version": "0.9.0",
  "description": "OpenCode TUI plugin: after each turn that changed code, shows in the sidebar and a review dialog what needs a human (business logic, architecture, data and migrations, secrets, third parties, unrequested changes); the rest goes to the PR.",
  "type": "module",
  "license": "MIT",
  "author": "Programación en español",
  "homepage": "https://github.com/pedrovelasquez9/review-radar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrovelasquez9/review-radar.git"
  },
  "keywords": ["opencode", "opencode-plugin", "tui", "code-review", "review", "diff", "ai"],
  "exports": {
    "./tui": "./opencode/src/tui.ts"
  },
  "oc-plugin": ["tui"],
  "files": ["core", "types", "opencode/src", "README.md", "README.es.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc -p opencode",
    "test": "bun test opencode"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.0",
    "@opentui/core": ">=0.4.2",
    "@opentui/solid": ">=0.4.2",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.17.10",
    "@opentui/core": "0.4.2",
    "@opentui/solid": "0.4.2",
    "@types/bun": "1.3.0",
    "solid-js": "1.9.9",
    "typescript": "5.9.3"
  }
}
